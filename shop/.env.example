# Server
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=./data/shop.db
# Long random string. Used as a Bearer token for /api/admin/* and the /admin page.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Store
SHOP_NAME=Kassa
CURRENCY=SEK
LOCALE=sv-SE
COUNTRY=SE
# Shipping in minor units (4900 = 49.00), VAT included. Free at or above the threshold.
SHIPPING_FEE=4900
FREE_SHIPPING_OVER=50000
SHIPPING_TAX_RATE=2500

# Klarna Payments. Leave the username empty to run a simulated checkout locally.
# Region API hosts: EU https://api.klarna.com, NA https://api-na.klarna.com, OC https://api-oc.klarna.com
KLARNA_USERNAME=
KLARNA_PASSWORD=
KLARNA_API_URL=https://api.playground.klarna.com
