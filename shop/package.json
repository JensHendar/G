{
  "name": "kassa",
  "version": "0.1.0",
  "description": "A tiny headless shop: JSON API, static storefront, Klarna checkout. Zero dependencies.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "build": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/build.js",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test"
  }
}
